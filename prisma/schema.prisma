datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

model User {
    id        Int      @id @default(autoincrement())
    name      String?
    email     String   @unique // Made required for standard login
    password  String   // Made required since every user needs a hashed password
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}


model EmailOtp {
  id        String   @id @default(cuid())
  email     String   @unique
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_otps")
}